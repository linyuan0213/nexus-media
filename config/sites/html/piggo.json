{
  "id": "piggo",
  "name": "猪猪",
  "domain": "https://piggo.me",
  "encoding": "UTF-8",
  "public": false,
  "tid_pattern": "/detail/(\\d+)",
  "html": {
    "search": {
      "paths": [
        {
          "path": "torrents",
          "method": "get"
        }
      ],
      "params": {
        "q": "{keyword}"
      }
    },
    "category": {
      "movie": [
        {
          "id": "movie",
          "cat": "Movies",
          "desc": "电影"
        }
      ],
      "tv": [
        {
          "id": "tv",
          "cat": "TV/Series",
          "desc": "电视剧"
        },
        {
          "id": "variety",
          "cat": "TV/Shows",
          "desc": "综艺"
        },
        {
          "id": "documentary",
          "cat": "TV/Documentaries",
          "desc": "纪录片"
        },
        {
          "id": "anime",
          "cat": "TV/Animations",
          "desc": "动漫"
        },
        {
          "id": "children",
          "cat": "TV/Series",
          "desc": "儿童"
        }
      ]
    },
    "conf": {
      "FREE": [
        "//span[contains(@class,'torrent-promo-2')]",
        "//span[contains(@class,'torrent-promo-4')]"
      ],
      "2XFREE": [
        "//span[contains(@class,'torrent-promo-4')]"
      ],
      "HR": [
        "//span[contains(@class,'torrent-promo-6')]"
      ],
      "PEER_COUNT": [
        "//div[contains(@class,'head-stats')]/button[@data-tip='做种']"
      ]
    },
    "browse": {
      "path": "torrents"
    },
    "torrents": {
      "list": {
        "selector": "table.torrent-list > tbody > tr"
      },
      "fields": {
        "id": {
          "selector": "a[href*=\"/detail/\"]",
          "attribute": "href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "\\d+",
                0
              ]
            }
          ]
        },
        "category": {
          "selector": "a.torrent-sec-chip",
          "optional": true
        },
        "title_default": {
          "selector": "a[href*=\"/detail/\"]"
        },
        "title": {
          "text": "{{ fields['title_default'] }}"
        },
        "details": {
          "selector": "a[href*=\"/detail/\"]",
          "attribute": "href"
        },
        "size": {
          "selector": "td.torrent-col-size"
        },
        "grabs": {
          "selector": "td.torrent-col-n[data-label=\"完成\"]"
        },
        "seeders": {
          "selector": "td.torrent-col-n[data-label=\"做种\"]"
        },
        "leechers": {
          "selector": "td.torrent-col-n[data-label=\"下载\"]"
        },
        "date_elapsed": {
          "selector": "td.torrent-col-time",
          "optional": true
        },
        "date": {
          "text": "{% if fields['date_elapsed'] %}{{ fields['date_elapsed'] }}{% else %}now{% endif %}"
        },
        "downloadvolumefactor": {
          "case": {
            "span:contains('免费')": 0,
            "span:contains('50%')": 0.5,
            "*": 1
          }
        },
        "uploadvolumefactor": {
          "case": {
            "*": 1
          }
        },
        "tags": {
          "selector": "a.torrent-tag",
          "optional": true
        },
        "subject": {
          "selector": "a[href*=\"/detail/\"]"
        },
        "description": {
          "selector": "div.torrent-sub",
          "optional": true
        },
        "labels": {
          "selector": "span.torrent-promo",
          "optional": true
        }
      }
    }
  },
  "download": {
    "type": "api_blob",
    "method": "POST",
    "path": "/torrents/{tid}/download"
  },
  "detail_page_url": "/detail/{tid}"
}

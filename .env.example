# Nexus Media 环境变量配置
# 复制为 .env 后修改，优先级：环境变量 > .env > config.yaml
# 嵌套 key 用 __ 分隔，如 APP__WEB_PORT -> AppSettings.app.web_port

# ==================== 核心 ====================
TZ=Asia/Shanghai
# NEXUS_PORT=3000

# ==================== 数据库 ====================
# DATABASE__TYPE=mysql
# DATABASE__HOST=localhost
# DATABASE__PORT=3306
# DATABASE__USERNAME=nexus_media
# DATABASE__PASSWORD=nexus_media_password
# DATABASE__DATABASE=nexus_media
# 连接池（MySQL/PostgreSQL）。默认主池 10+10、调度池 5+5，进程最多占用 30 条连接，
# 其中常驻不超过 15 条（pool_size 决定常驻，max_overflow 提供峰值弹性）。
# PostgreSQL 官方默认 max_connections=100（另保留 3 条给超级用户），但实例常被多个服务共用，
# 也可能被收紧到 40~60；调大前请确认「主池 + 调度池 + 其他客户端」仍有余量，
# 否则会报 "remaining connection slots are reserved for roles with the SUPERUSER attribute"
# DATABASE__POOL_SIZE=10
# DATABASE__MAX_OVERFLOW=10
# DATABASE__POOL_TIMEOUT=15
# DATABASE__SCHEDULER_POOL_SIZE=5
# DATABASE__SCHEDULER_MAX_OVERFLOW=5
# DATABASE__SCHEDULER_POOL_TIMEOUT=15
# 连接预算的自动探测与并发上限（一般无需修改）
# 未配置时 PostgreSQL 默认 100、MySQL 默认 151；探测失败时使用该默认值
# DATABASE__MAX_CONNECTIONS=100
# DATABASE__CONNECTION_RESERVE=3
# DATABASE__EXTERNAL_CONNECTION_RESERVE=5
# DATABASE__API_CONNECTION_RESERVE=8
# DATABASE__SYNC_WORKERS=4
# DATABASE__SYNC_WORKERS_MAX=8

# ==================== 应用 ====================
# APP__WEB_HOST=::
# APP__WEB_PORT=3000
# APP__LOGIN_USER=admin
# APP__LOGIN_PASSWORD=password
# APP__DEBUG=true
# APP__DOMAIN=example.com
# APP__RMT_TMDBKEY=
# APP__WALLPAPER=bing

# ==================== 媒体 ====================
# MEDIA__TMDB_LANGUAGE=zh
# MEDIA__MEDIASYNC_INTERVAL=8
# MEDIA__DEFAULT_RMT_MODE=link

# ==================== 订阅监控 ====================
# SUBSCRIBE__QUEUE_INTERVAL=300
# SUBSCRIBE__RSS_INTERVAL=1800
# SUBSCRIBE__SEARCH_INTERVAL=6

# ==================== PT 站点 ====================
# PT__SEARCH_AUTO=false
# PT__DOWNLOAD_ORDER=seeder

# ==================== 安全 ====================
# SECURITY__JWT_SECRET=

# ==================== 实验室 ====================
# LABORATORY__CHROME_SERVER_HOST=http://localhost:9850
# LABORATORY__OCR_SERVER_HOST=http://localhost:9300

# ==================== Redis ====================
# REDIS__HOST=127.0.0.1
# REDIS__PORT=6379
# REDIS__PASSWORD=
# REDIS__DB=0

# ==================== 日志 ====================
# LOG__TYPE=file
# LOG__LEVEL=debug
# LOG__PATH=./logs
# LOG__FORMAT=json

# ==================== Agent ====================
# AGENT__ENABLED=false
# AGENT__DEFAULT_PROVIDER=deepseek
# AGENT__PROVIDERS__DEEPSEEK__API_KEY=
# AGENT__PROVIDERS__DEEPSEEK__API_URL=https://api.deepseek.com
# AGENT__PROVIDERS__DEEPSEEK__MODEL=deepseek-chat

# ==================== 可选组件 ====================
# nexus-chrome VNC 密码（full-mysql / full-postgresql 模式必填，禁止使用默认值 password）
# 未设置时 docker compose up 会报错并提示
VNC_PASSWORD=

# nexus-chrome API 鉴权密码（可选）：设置后启用登录页 + API 鉴权，
# 需在后端「实验室 → 访问凭证（API Key）」中配置凭证，否则浏览器请求被 401 拒绝
# AUTH_PASSWORD=

# 插件事件回调线程池大小（默认 8，上限 32）
# PLUGIN_HOOK_WORKERS=8

#!/usr/bin/with-contenv bash
# shellcheck shell=bash

function __fixuser {
    PUID="${PUID:-0}"
    PGID="${PGID:-0}"

    echo "以PUID=${PUID}，PGID=${PGID}的身份启动程序..."

    if ! [[ "$PUID" =~ ^[0-9]+$ ]]; then PUID=0; fi
    if ! [[ "$PGID" =~ ^[0-9]+$ ]]; then PGID=0; fi

    current_uid="$(id -u nexus 2>/dev/null || echo 911)"
    current_gid="$(id -g nexus 2>/dev/null || echo 911)"
    if [ "$PUID" != "$current_uid" ] || [ "$PGID" != "$current_gid" ]; then
        # 更改 nexus userid 和 groupid；镜像若继承了被污染的 0:0 账号，
        # usermod 会因 PID 1 占用而失败，此时兜底写入 passwd/group。
        groupmod -o -g "$PGID" nexus 2>/dev/null ||             sed -i "s/^nexus:x:[0-9]*:/nexus:x:${PGID}:/" /etc/group
        usermod -o -u "$PUID" nexus 2>/dev/null ||             sed -i "s/^nexus:x:[0-9]*:[0-9]*:/nexus:x:${PUID}:${PGID}:/" /etc/passwd
        if [ "$PUID" != "0" ] || [ "$PGID" != "0" ]; then
            # 仅在非 root 运行时整理挂载卷权限，避免每次启动递归扫描 HOME
            chown -R nexus:nexus "${HOME}" /config /etc/hosts 2>/dev/null || true
        fi
    else
        chown nexus:nexus /etc/hosts 2>/dev/null || true
    fi

    # nginx 以 nexus 身份运行（PUID/PGID 非 0 时非 root），需保证其临时/日志/pid 目录可写，
    # 否则会报 mkdir() "/var/lib/nginx/body" failed (13: Permission denied)
    mkdir -p /var/lib/nginx/body /var/lib/nginx/proxy /var/lib/nginx/fastcgi \
        /var/lib/nginx/uwsgi /var/lib/nginx/scgi /var/log/nginx /run/nginx
    chown -R nexus:nexus /var/lib/nginx /var/log/nginx /run/nginx

}

__fixuser 2>&1 | sed "s#^#cont-init: info: $(realpath $0): &#g"